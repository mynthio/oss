{
  "name": "@mynthio/sdk",
  "version": "0.0.41",
  "description": "Official Mynth SDK for image generation and analysis",
  "keywords": [
    "ai",
    "image-generation",
    "mynth",
    "sdk"
  ],
  "homepage": "https://mynth.io",
  "license": "MIT",
  "author": "mynth.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynthio/oss.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./convex": {
      "types": "./dist/convex/index.d.ts",
      "default": "./dist/convex/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start/index.d.ts",
      "default": "./dist/tanstack-start/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^22.20.4",
    "convex": "^1.46.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "convex": "^1.27.3"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": true
    }
  }
}
