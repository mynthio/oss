{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],

    // Every export spells out its type, so tsdown generates declarations with
    // oxc instead of running the type checker.
    "declaration": true,
    "isolatedDeclarations": true
  },
  "include": ["src"]
}
