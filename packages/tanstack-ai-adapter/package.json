{
  "name": "@mynthio/tanstack-ai-adapter",
  "version": "0.0.33",
  "description": "Mynth image generation adapter for TanStack AI",
  "keywords": [
    "adapter",
    "ai",
    "image-generation",
    "mynth",
    "tanstack"
  ],
  "license": "MIT",
  "author": "mynth.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynthio/oss.git",
    "directory": "packages/tanstack-ai-adapter"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./byok": {
      "types": "./dist/byok.d.ts",
      "default": "./dist/byok.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mynthio/sdk": "0.0.49"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@tanstack/ai": "^0.61.0",
    "@vitest/coverage-v8": "^5.0.2",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@tanstack/ai": ">=0.61.0"
  }
}
