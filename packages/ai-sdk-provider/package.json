{
  "name": "@mynthio/ai-sdk-provider",
  "version": "0.0.0",
  "description": "Mynth image and video generation provider for the Vercel AI SDK",
  "keywords": [
    "ai",
    "ai-sdk",
    "image-generation",
    "mynth",
    "provider",
    "vercel",
    "video-generation"
  ],
  "license": "MIT",
  "author": "mynth.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynthio/oss.git",
    "directory": "packages/ai-sdk-provider"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
