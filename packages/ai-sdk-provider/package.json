  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.2",
    "ai": "^7.0.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
